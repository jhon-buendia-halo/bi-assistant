{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/DataModel",
  "$defs": {
    "DataModel": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "description": {
          "type": "string"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Entity"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Relationship"
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Metric"
          }
        }
      },
      "required": [
        "model",
        "version",
        "entities",
        "relationships",
        "metrics"
      ],
      "additionalProperties": false
    },
    "Entity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "key": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bindings": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Binding"
          }
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attribute"
          }
        }
      },
      "required": [
        "name",
        "bindings",
        "attributes"
      ],
      "additionalProperties": false
    },
    "Binding": {
      "oneOf": [
        {
          "$ref": "#/$defs/SqlBinding"
        },
        {
          "$ref": "#/$defs/RestBinding"
        },
        {
          "$ref": "#/$defs/MongoBinding"
        },
        {
          "$ref": "#/$defs/FileBinding"
        }
      ]
    },
    "SqlBinding": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "sql"
        },
        "datasource": {
          "type": "string",
          "minLength": 1
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "datasource",
        "table"
      ],
      "additionalProperties": false
    },
    "RestBinding": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "rest"
        },
        "datasource": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "recordPath": {
          "type": "string"
        },
        "columns": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "datasource",
        "endpoint"
      ],
      "additionalProperties": false
    },
    "MongoBinding": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "mongo"
        },
        "datasource": {
          "type": "string",
          "minLength": 1
        },
        "collection": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "datasource",
        "collection"
      ],
      "additionalProperties": false
    },
    "FileBinding": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "file"
        },
        "datasource": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "enum": [
            "csv",
            "json",
            "ndjson"
          ]
        },
        "recordPath": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path",
        "format"
      ],
      "additionalProperties": false
    },
    "Attribute": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "date",
            "datetime",
            "time",
            "json",
            "unknown"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "key",
            "dimension",
            "measure",
            "time"
          ]
        },
        "nullable": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "samples": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false
    },
    "Relationship": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "cardinality": {
          "type": "string",
          "enum": [
            "one_to_one",
            "many_to_one",
            "one_to_many",
            "many_to_many"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "declared",
            "inferred",
            "user"
          ]
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "cardinality",
        "source"
      ],
      "additionalProperties": false
    },
    "Metric": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "entity": {
          "type": "string",
          "minLength": 1
        },
        "agg": {
          "type": "string",
          "enum": [
            "sum",
            "count",
            "count_distinct",
            "avg",
            "min",
            "max",
            "ratio"
          ]
        },
        "of": {
          "type": "string"
        },
        "numerator": {
          "type": "string"
        },
        "denominator": {
          "type": "string"
        },
        "where": {
          "$ref": "#/$defs/Predicate"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expressions": {
          "type": "object",
          "properties": {
            "sql": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "sourceVerifiedQueryId": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "label",
        "entity"
      ],
      "additionalProperties": false
    },
    "Predicate": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "and": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Predicate"
              }
            }
          },
          "required": [
            "and"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "or": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Predicate"
              }
            }
          },
          "required": [
            "or"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/Predicate"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "attr": {
              "type": "string",
              "minLength": 1
            },
            "op": {
              "type": "string",
              "enum": [
                "eq",
                "ne",
                "gt",
                "gte",
                "lt",
                "lte",
                "in",
                "not_in",
                "between",
                "is_null",
                "not_null",
                "contains",
                "starts_with"
              ]
            },
            "value": {}
          },
          "required": [
            "attr",
            "op"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "description": {
      "type": "string"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entity"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Relationship"
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Metric"
      }
    }
  },
  "required": [
    "model",
    "version",
    "entities",
    "relationships",
    "metrics"
  ],
  "additionalProperties": false
}