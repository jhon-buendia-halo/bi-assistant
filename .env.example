# Jira connection for the `jira` MCP server (.claude/tools/jira) and skill (.claude/skills/jira).
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://halo-powered.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=BA

# OpenAI key for the backend (specs/system/api.md 6.1): the fallback chat model when no LLM settings are
# saved, and the embeddings of the memory of past sessions when the saved provider is not OpenAI
# (specs/system/agents.md 2.1). Leave unset if you use neither. No local embedding model ships.
# OPENAI_API_KEY=
