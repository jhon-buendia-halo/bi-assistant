# Jira connection for the `jira` Claude skill (.claude/skills/jira).
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://halo-powered.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=BA

# Hindsight memory (roadmap 1.3.6). The backend reads HINDSIGHT_URL / HINDSIGHT_API_KEY;
# the `hindsight` compose service (docker compose --profile memory up -d hindsight) reads
# OPENAI_API_KEY for fact extraction and embeddings. Unset HINDSIGHT_URL = memory off.
OPENAI_API_KEY=
HINDSIGHT_URL=http://127.0.0.1:8888
HINDSIGHT_API_KEY=
