{
  "enabledPlugins": {},
  "extraKnownMarketplaces": {},
  "enabledMcpjsonServers": [
    "jira"
  ],
  "permissions": {
    "allow": [
      "mcp__jira__whoami",
      "mcp__jira__get_project",
      "mcp__jira__search_issues",
      "mcp__jira__get_issue",
      "mcp__jira__list_statuses",
      "mcp__jira__list_transitions"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/demo-reminder.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
