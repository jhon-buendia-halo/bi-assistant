{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "mastra/skills/**/*",
        "watchAssets": true
      },
      {
        "include": "modules/testing-data/fixtures/**/*.sql*",
        "watchAssets": true
      }
    ]
  }
}
