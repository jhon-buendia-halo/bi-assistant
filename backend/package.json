{
  "name": "questions-to-insights",
  "version": "0.17.0",
  "description": "Ask questions of your data in plain language and get answers, SQL and interactive visuals. Runs locally: npx questions-to-insights",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhon-buendia-halo/questions-to-insights.git",
    "directory": "backend"
  },
  "bin": {
    "questions-to-insights": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "public"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "eval": "ts-node -T -P tsconfig.json scripts/run-eval.ts",
    "check:answers": "ts-node -T -P tsconfig.json scripts/check-answers.ts",
    "evals:assistant": "nest build && node dist/mastra/evals/run-assistant-evals.js",
    "build:web": "npm --prefix ../frontend run build:web && node scripts/copy-web.js",
    "build:all": "npm run build && npm run build:web",
    "prepack": "npm run build:all",
    "start:web": "node dist/cli.js"
  },
  "dependencies": {
    "@databricks/sql": "2.1.0",
    "@mastra/core": "1.66.0",
    "@mastra/duckdb": "1.8.0",
    "@mastra/evals": "1.10.2",
    "@mastra/libsql": "1.22.5",
    "@mastra/loggers": "1.3.1",
    "@mastra/memory": "1.29.0",
    "@mastra/observability": "1.17.8",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "better-sqlite3": "13.0.3",
    "marked": "18.0.13",
    "pg": "8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "2.17.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "mastra": "1.29.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
