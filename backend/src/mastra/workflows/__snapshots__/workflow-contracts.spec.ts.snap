    {
      "id": "wrap-up",
      "inputSchema": {
        "properties": {
          "answer": {
            "description": "The run's answer.",
            "type": "string",
          },
          "calls": {
            "description": "The last attempt's tool calls.",
            "items": {
              "properties": {
                "failed": {
                  "description": "Whether the call failed.",
                  "type": "boolean",
                },
