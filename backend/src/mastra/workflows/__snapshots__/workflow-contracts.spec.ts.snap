              ],
              "type": "object",
            },
            "type": "array",
          },
          "imageNotes": {
            "description": "Read images' notes on the run's reference images; '' when it has none.",
            "type": "string",
          },
          "plan": {
            "description": "The analysis plan.",
            "properties": {
              "assumptions": {
                "description": "Each default chosen for something the question leaves open.",
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
              "clarification": {
                "anyOf": [
                  {
                    "properties": {
                      "options": {
                        "description": "2-4 answer options, each a short title, optionally followed by " — " and one line explaining it.",
                        "items": {
                          "type": "string",
                        },
                        "maxItems": 4,
                        "minItems": 2,
                        "type": "array",
                      },
                      "question": {
                        "description": "One short clarifying question.",
                        "type": "string",
                      },
                    },
                    "required": [
                      "question",
                      "options",
                    ],
                    "type": "object",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "The question to ask when needsClarification is true, else null.",
              },
              "entities": {
                "description": "The catalog entities the analysis will likely read.",
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
              "measures": {
                "description": "The figures the answer needs.",
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
              "needsClarification": {
                "description": "The metric or meaning is undefined and the choice changes the analysis.",
                "type": "boolean",
              },
              "question": {
                "description": "The question restated in one sentence, its defaults explicit.",
                "type": "string",
              },
              "scope": {
                "description": "The slice of the data the answer covers.",
                "type": "string",
              },
            },
            "required": [
              "question",
              "measures",
              "entities",
              "scope",
              "assumptions",
              "needsClarification",
              "clarification",
            ],
            "type": "object",
          },
          "queries": {
            "description": "The SQL queries of the last attempt, with their rows.",
            "items": {
              "properties": {
                "error": {
                  "description": "Why it failed.",
                  "type": "string",
                },
                "rationale": {
                  "description": "Why the agent ran it.",
                  "type": "string",
                },
                "rowCount": {
                  "description": "Rows it returned.",
                  "type": "number",
                },
                "rows": {
                  "description": "Its result rows, at most 200.",
                  "items": {
                    "additionalProperties": {},
                    "propertyNames": {
                      "type": "string",
                    },
                    "type": "object",
                  },
                  "type": "array",
                },
                "sql": {
                  "description": "The statement that ran.",
                  "type": "string",
                },
                "truncated": {
                  "description": "The result was cut at its row limit or when stored.",
                  "type": "boolean",
                },
              },
              "required": [
                "sql",
                "rows",
                "rowCount",
                "truncated",
              ],
              "type": "object",
            },
            "type": "array",
          },
          "question": {
            "description": "The trimmed question.",
            "type": "string",
          },
        },
        "required": [
          "question",
          "plan",
          "queries",
          "findings",
          "calls",
          "imageNotes",
        ],
        "type": "object",
      },
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "answer": {
            "description": "The run's answer in Markdown, starting with the headline.",
            "type": "string",
          },
          "calls": {
            "description": "The last attempt's tool calls.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "failed": {
                  "description": "Whether the call failed.",
                  "type": "boolean",
                },
                "rowCount": {
                  "description": "Rows a SQL call returned.",
                  "type": "number",
                },
                "tool": {
                  "description": "The tool name.",
                  "type": "string",
                },
              },
              "required": [
                "tool",
                "failed",
              ],
              "type": "object",
            },
            "type": "array",
          },
          "headline": {
            "description": "One line that answers the question with the key figure.",
            "type": "string",
          },
        },
        "required": [
          "headline",
          "answer",
          "calls",
        ],
        "type": "object",
      },
    },
