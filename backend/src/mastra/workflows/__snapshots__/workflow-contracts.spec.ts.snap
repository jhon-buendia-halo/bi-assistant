exports[`every catalogued workflow keeps its data contract at run time (agents.md 5.12) map-dashboard-data's contract (JSON Schemas and hash) is the reviewed one 1`] = `
{
  "contractHash": "5adb1f3d73d3",
  "edges": [
    {
      "from": "start",
      "kind": "next",
      "label": "No images",
      "to": "load-dashboard",
    },
    {
      "from": "start",
      "kind": "branch",
      "label": "Reference images",
      "to": "read-images",
    },
    {
      "from": "read-images",
      "kind": "next",
      "to": "load-dashboard",
    },
    {
      "from": "load-dashboard",
      "kind": "next",
      "to": "load-dashboard-catalog",
    },
    {
