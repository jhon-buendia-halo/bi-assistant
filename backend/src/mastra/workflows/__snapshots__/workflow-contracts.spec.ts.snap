          "failedQueries": {
            "description": "Of those, the ones that failed.",
            "type": "number",
          },
          "rows": {
            "description": "Rows the successful queries returned.",
            "type": "number",
          },
          "sqlQueries": {
            "description": "SQL queries the last attempt ran.",
            "type": "number",
