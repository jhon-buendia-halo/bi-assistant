            "description": "The saved dashboard's name.",
            "type": "string",
          },
          "blueprint": {
            "additionalProperties": false,
            "description": "The dashboard's structure.",
            "properties": {
              "columns": {
                "description": "The columns of one mock dataset every widget can read.",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "description": {
                      "description": "What it holds.",
                      "type": "string",
                    },
                    "max": {
                      "description": "A number column: a plausible high.",
                      "type": [
                        "number",
                        "null",
                      ],
                    },
