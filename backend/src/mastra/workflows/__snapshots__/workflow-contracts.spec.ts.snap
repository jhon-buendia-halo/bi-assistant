                      },
                    },
                    "required": [
                      "question",
                      "options",
                    ],
                    "type": "object",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "The question to ask when needsClarification is true, else null.",
              },
              "entities": {
                "description": "The catalog entities the analysis will likely read.",
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
              "measures": {
                "description": "The figures the answer needs.",
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
              "needsClarification": {
                "description": "The metric or meaning is undefined and the choice changes the analysis.",
                "type": "boolean",
              },
              "question": {
                "description": "The question restated in one sentence, its defaults explicit.",
                "type": "string",
              },
              "scope": {
                "description": "The slice of the data the answer covers.",
                "type": "string",
              },
            },
            "required": [
              "question",
              "measures",
              "entities",
              "scope",
              "assumptions",
              "needsClarification",
              "clarification",
            ],
            "type": "object",
          },
          "queries": {
            "description": "The checked attempt's SQL queries.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "error": {
                  "description": "Why it failed.",
                  "type": "string",
                },
                "rationale": {
                  "description": "Why the agent ran it.",
                  "type": "string",
                },
                "rowCount": {
                  "description": "Rows it returned.",
                  "type": "number",
                },
                "rows": {
                  "description": "Its result rows, at most 200.",
                  "items": {
                    "additionalProperties": {},
                    "propertyNames": {
                      "type": "string",
                    },
                    "type": "object",
                  },
                  "type": "array",
                },
                "sql": {
                  "description": "The statement that ran.",
                  "type": "string",
                },
                "truncated": {
                  "description": "The result was cut at its row limit or when stored.",
                  "type": "boolean",
                },
              },
              "required": [
                "sql",
                "rows",
                "rowCount",
                "truncated",
              ],
              "type": "object",
            },
            "type": "array",
          },
          "question": {
            "description": "The trimmed question.",
            "type": "string",
          },
        },
        "required": [
          "ok",
          "attempt",
          "findings",
          "question",
          "catalog",
          "plan",
          "calls",
          "queries",
          "imageNotes",
        ],
        "type": "object",
      },
    },
    {
      "id": "write-answer",
      "inputSchema": {
        "properties": {
          "calls": {
            "description": "The last attempt's tool calls, for Wrap up.",
            "items": {
              "properties": {
                "failed": {
                  "description": "Whether the call failed.",
                  "type": "boolean",
                },
                "rowCount": {
                  "description": "Rows a SQL call returned.",
                  "type": "number",
                },
