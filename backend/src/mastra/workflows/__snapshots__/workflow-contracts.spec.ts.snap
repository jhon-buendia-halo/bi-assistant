    {
      "id": "page-result",
      "inputSchema": {
        "properties": {
          "catalog": {
            "description": "The entities of the run's datasets.",
            "items": {
              "properties": {
                "columnCount": {
                  "description": "Its column count, when known.",
                  "type": [
                    "number",
                    "null",
                  ],
                },
                "dataset": {
                  "description": "The dataset it belongs to.",
                  "type": "string",
                },
                "datasourceId": {
                  "description": "The dataset's datasource id.",
                  "type": [
                    "string",
                    "null",
                  ],
                },
                "datasourceKind": {
                  "description": "postgres, databricks, rest or file.",
                  "type": [
                    "string",
                    "null",
                  ],
                },
                "entity": {
                  "description": "The entity (table) key.",
                  "type": "string",
                },
              },
              "required": [
                "entity",
                "dataset",
                "datasourceId",
                "datasourceKind",
                "columnCount",
              ],
              "type": "object",
            },
            "type": "array",
          },
          "columns": {
            "description": "The columns of each entity, for Plan only: at most 40 per entity and 400 in all.",
            "items": {
              "properties": {
                "columns": {
                  "description": "Its columns, in dataset order (capped).",
                  "items": {
                    "properties": {
                      "name": {
                        "description": "The column name.",
                        "type": "string",
                      },
                      "type": {
                        "description": "Its type, as the dataset records it.",
                        "type": "string",
                      },
                    },
                    "required": [
                      "name",
                      "type",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
                "entity": {
                  "description": "The entity (table) key.",
                  "type": "string",
                },
                "more": {
                  "description": "How many more columns it has that are not listed.",
                  "type": "number",
                },
              },
              "required": [
                "entity",
                "columns",
                "more",
              ],
              "type": "object",
            },
            "type": "array",
          },
          "followUp": {
            "anyOf": [
              {
                "properties": {
                  "action": {
                    "const": "explore",
                    "description": "The words ask for the earlier rows paged, filtered or sorted.",
                    "type": "string",
                  },
                  "query": {
                    "description": "The 0-based index of the earlier query in the run's queries.",
                    "type": "number",
                  },
                  "ref": {
                    "description": "Its label: Q1, Q2, …",
                    "type": "string",
                  },
                  "request": {
                    "description": "The page, filters and sort to read.",
                    "properties": {
                      "filters": {
                        "description": "The filters, AND-ed.",
                        "items": {
                          "properties": {
                            "column": {
                              "description": "The result column.",
                              "type": "string",
                            },
                            "op": {
                              "description": "The operator.",
                              "enum": [
                                "eq",
                                "neq",
                                "gt",
                                "gte",
                                "lt",
                                "lte",
                                "between",
                                "in",
                                "not_in",
                                "contains",
                                "not_contains",
                                "starts_with",
                                "is_null",
                                "not_null",
                              ],
                              "type": "string",
                            },
                            "value": {
                              "description": "Its value.",
                              "type": [
                                "string",
                                "number",
                                "boolean",
                              ],
                            },
                            "valueTo": {
                              "description": "The upper bound of between.",
                              "type": [
                                "string",
                                "number",
                                "boolean",
                              ],
                            },
                            "values": {
                              "description": "The values of in and not_in.",
                              "items": {
                                "type": [
                                  "string",
                                  "number",
                                  "boolean",
                                ],
                              },
                              "type": "array",
                            },
                          },
                          "required": [
                            "column",
                            "op",
                          ],
                          "type": "object",
                        },
                        "type": "array",
                      },
                      "page": {
                        "description": "1-based; default 1.",
                        "type": "number",
                      },
                      "pageSize": {
                        "description": "Rows a page; default 50.",
                        "type": "number",
                      },
                      "sort": {
                        "description": "The sort keys; none is the default order.",
                        "items": {
                          "properties": {
                            "column": {
                              "description": "The result column.",
                              "type": "string",
                            },
                            "direction": {
                              "description": "Its direction.",
                              "enum": [
                                "asc",
                                "desc",
                              ],
                              "type": "string",
                            },
                          },
                          "required": [
                            "column",
                            "direction",
                          ],
                          "type": "object",
                        },
                        "type": "array",
                      },
                    },
                    "type": "object",
                  },
                  "understood": {
                    "description": "The request in one line of words.",
                    "type": "string",
                  },
                },
                "required": [
                  "action",
                  "query",
                  "ref",
                  "request",
                  "understood",
                ],
                "type": "object",
              },
              {
                "type": "null",
              },
            ],
            "description": "The page of an earlier result the words ask for; null: a new question, planned.",
          },
          "imageNotes": {
            "description": "Read images' notes on the run's reference images; '' when it has none.",
            "type": "string",
          },
          "question": {
            "description": "The trimmed question.",
            "type": "string",
          },
          "stopped": {
            "description": "Set when the turn was stopped while the words were read: nothing after runs.",
            "type": "boolean",
          },
        },
        "required": [
          "question",
          "catalog",
          "columns",
          "imageNotes",
          "followUp",
        ],
        "type": "object",
      },
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "capped": {
            "description": "More rows matched than can be paged.",
            "type": "boolean",
          },
          "columns": {
            "description": "The result's columns.",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "matchedRows": {
            "description": "Rows matching the filters.",
            "type": "number",
          },
          "page": {
            "description": "The page read, 1-based.",
            "type": "number",
          },
          "pageCount": {
            "description": "Pages the matching rows fill.",
            "type": "number",
          },
          "rows": {
            "description": "The page's rows, at most 100.",
            "items": {
              "additionalProperties": {},
              "propertyNames": {
                "type": "string",
              },
              "type": "object",
            },
            "type": "array",
          },
          "title": {
            "description": "The earlier query, in words.",
            "type": "string",
          },
          "understood": {
            "description": "The view in one line of words.",
            "type": "string",
          },
          "view": {
            "additionalProperties": false,
            "description": "The view the page was read with.",
            "properties": {
              "capped": {
                "description": "More rows matched than paged.",
                "type": "boolean",
              },
              "filters": {
                "description": "The filters, AND-ed.",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "column": {
                      "description": "The result column.",
                      "type": "string",
                    },
                    "op": {
                      "description": "The operator.",
                      "enum": [
                        "eq",
                        "neq",
                        "gt",
                        "gte",
                        "lt",
                        "lte",
                        "between",
                        "in",
                        "not_in",
                        "contains",
                        "not_contains",
                        "starts_with",
                        "is_null",
                        "not_null",
                      ],
                      "type": "string",
                    },
                    "value": {
                      "description": "Its value.",
                      "type": [
                        "string",
                        "number",
                        "boolean",
                      ],
                    },
                    "valueTo": {
                      "description": "The upper bound of between.",
                      "type": [
                        "string",
                        "number",
                        "boolean",
                      ],
                    },
                    "values": {
                      "description": "The values of in and not_in.",
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                        ],
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "column",
                    "op",
                  ],
                  "type": "object",
                },
                "type": "array",
              },
              "matchedRows": {
                "description": "Rows matching the filters.",
                "type": "number",
              },
              "page": {
                "description": "The page, 1-based.",
                "type": "number",
              },
              "pageSize": {
                "description": "Rows a page.",
                "type": "number",
              },
              "sort": {
                "description": "The sort keys.",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "column": {
                      "description": "The result column.",
                      "type": "string",
                    },
                    "direction": {
                      "description": "Its direction.",
                      "enum": [
                        "asc",
                        "desc",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "column",
                    "direction",
                  ],
                  "type": "object",
                },
                "type": "array",
              },
            },
            "required": [
              "filters",
              "sort",
              "page",
              "pageSize",
            ],
            "type": "object",
          },
        },
        "required": [
          "title",
          "columns",
          "rows",
          "page",
          "pageCount",
          "matchedRows",
          "capped",
          "view",
          "understood",
        ],
        "type": "object",
      },
    },
    {
      "id": "page-answer",
      "inputSchema": {
        "properties": {
          "capped": {
            "description": "More rows matched than can be paged.",
            "type": "boolean",
          },
          "columns": {
            "description": "The result's columns.",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "matchedRows": {
            "description": "Rows matching the filters.",
            "type": "number",
          },
          "page": {
            "description": "The page read, 1-based.",
            "type": "number",
          },
          "pageCount": {
            "description": "Pages the matching rows fill.",
            "type": "number",
          },
          "rows": {
            "description": "The page's rows, at most 100.",
            "items": {
